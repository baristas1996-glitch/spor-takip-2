{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spor-takip-2",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-22",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "spor-takip-2-db",
      "database_id": "7a64a44d-0504-46e3-97aa-8a46ad1eacd7"
    }
  ]
}
